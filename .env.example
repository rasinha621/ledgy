# Copy to .env and change the values.
# The name or IP address you type in the browser (e.g. nas.local or 192.168.1.20).
LEDGY_HOST=localhost
# The port on the server.
HTTP_PORT=3000
TZ=America/New_York
PUID=568
PGID=568
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# The app does not start without a login unless this is 1.
ALLOW_NO_AUTH=
# Host names used to open the app, comma-separated (needed for a name like nas.local when there is no login).
ALLOWED_HOSTS=
